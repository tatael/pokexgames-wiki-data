# HTTP request timeout in milliseconds
WIKI_FETCH_TIMEOUT_MS=60000

# Number of retry attempts per HTTP request
WIKI_FETCH_RETRY_ATTEMPTS=3

# Fetch mode: live | cache | prefer-cache
WIKI_FETCH_MODE=live

# Max age (hours) before cached HTML is considered stale
WIKI_FETCH_CACHE_HOURS=168

# Max concurrent Pokémon API requests during discovery
WIKI_DISCOVERY_CONCURRENCY=48

# Max concurrent page sync requests
WIKI_SYNC_CONCURRENCY=24

# Max age (hours) before discovered Pokémon cache is considered stale
WIKI_DISCOVERY_CACHE_HOURS=168

# Force full Pokémon rediscovery (ignores cache)
WIKI_DISCOVERY_FORCE=false

# Skip bundle validation after sync
WIKI_SKIP_VALIDATE=false

# Sync only specific slugs (comma-separated)
WIKI_SYNC_ONLY=

# Sync only specific categories (comma-separated)
WIKI_SYNC_CATEGORY=

# Force-refresh specific pages (comma-separated slugs or URLs)
WIKI_REFRESH=

# Dev server port
PORT=8787
